# Copy to .env and fill in. Never commit .env.
# Lists use JSON, e.g. WORK_DAYS=[0,1,2,3,4]

# --- Language model ---
# ollama = free local model (default) | claude = Anthropic API (paid)
# openai = Groq free tier or any OpenAI-compatible API (email text is sent to the provider)
LLM_PROVIDER=ollama

# --- Ollama (when LLM_PROVIDER=ollama) ---
OLLAMA_BASE_URL=http://127.0.0.1:11434
# Must support tool calling. qwen3:8b (needs ~8 GB free RAM) or qwen3:4b / llama3.2:3b on smaller machines
OLLAMA_MODEL=qwen3:8b
# Context window in tokens. Lower it if the model runs out of memory; raise it for long emails.
OLLAMA_NUM_CTX=16384
OLLAMA_TIMEOUT_SECONDS=600
# Keep the model loaded between requests (faster follow-ups). Use e.g. 5m to free memory sooner.
OLLAMA_KEEP_ALIVE=30m
# Uncomment for thinking models (e.g. qwen3): false = faster answers, true = more careful
# OLLAMA_THINK=false

# --- Claude (only when LLM_PROVIDER=claude) ---
ANTHROPIC_API_KEY=your-anthropic-api-key
CLAUDE_MODEL=claude-opus-5-5
# low | medium | high | xhigh | max
CLAUDE_EFFORT=medium
CLAUDE_MAX_TOKENS=16000
# Retry a declined request on a fallback model (server-side). Set false if your model rejects it.
CLAUDE_REFUSAL_FALLBACK=true

# --- OpenAI-compatible API (only when LLM_PROVIDER=openai). Defaults to Groq. ---
# Groq key: https://console.groq.com/keys   Models: https://console.groq.com/docs/models
OPENAI_BASE_URL=https://api.groq.com/openai/v1
OPENAI_API_KEY=your-groq-api-key
# Must support tool calling
OPENAI_MODEL=openai/gpt-oss-120b
OPENAI_MAX_TOKENS=2048

# --- Google Apps Script bridge (required for Gmail / Calendar / Drive) ---
# The Web App URL ending in /exec, from Deploy > Manage deployments
APPS_SCRIPT_URL=https://script.google.com/macros/s/your-deployment-id/exec
# Random secret you generate: python3 -c "import secrets; print(secrets.token_hex(32))"
# Paste the same value into Apps Script > Project Settings > Script properties as BRIDGE_SHARED_SECRET
APPS_SCRIPT_SHARED_SECRET=your-shared-secret
BRIDGE_TIMEOUT_SECONDS=30

# --- Server (local only) ---
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8000
FRONTEND_ORIGIN=http://localhost:5173

# --- Agent and session limits ---
MAX_AGENT_STEPS=10
PROMPT_MAX_CHARS=4000
TOOL_RESULT_MAX_CHARS=20000
APPROVAL_TTL_SECONDS=600
SESSION_IDLE_TTL_SECONDS=3600

# --- Gmail limits ---
EMAIL_SEARCH_MAX_RESULTS=20
EMAIL_BODY_MAX_CHARS=10000
OUTGOING_BODY_MAX_CHARS=20000
SUBJECT_MAX_CHARS=250
MAX_RECIPIENTS=20

# --- Calendar ---
# IANA timezone, e.g. Asia/Kolkata, Europe/London, America/New_York
USER_TIMEZONE=UTC
WORK_DAY_START=09:00
WORK_DAY_END=17:00
# Monday=0 ... Sunday=6
WORK_DAYS=[0,1,2,3,4]
SLOT_GRID_MINUTES=30
MAX_SUGGESTED_SLOTS=5
AVAILABILITY_MAX_RANGE_DAYS=14

# --- Drive ---
ATTACHMENT_FOLDER_NAME=Email Attachments
# 10 MB
ATTACHMENT_MAX_BYTES=10485760
SUPPORTED_ATTACHMENT_EXTENSIONS=["pdf","doc","docx","xls","xlsx","ppt","pptx","csv","txt","png","jpg","jpeg","gif"]
DRIVE_SEARCH_MAX_RESULTS=25
