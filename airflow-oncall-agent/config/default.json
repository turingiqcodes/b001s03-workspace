{
  "_comment": "Non-secret defaults. Overridden by config/<APP_ENV>.json, then by environment variables. Never put credentials here.",
  "airflow": {
    "timeout_seconds": 30,
    "verify_tls": true,
    "page_size": 100,
    "max_retries_on_transient_error": 2
  },
  "github": {
    "dag_path_prefix": "dags/",
    "lookback_days": 7,
    "max_commits": 10,
    "timeout_seconds": 30
  },
  "linear": {
    "timeout_seconds": 30,
    "labels": {
      "base": "oncall",
      "approved": "oncall:approved",
      "classification": {
        "retriable": "oncall:retriable",
        "non_retriable": "oncall:non-retriable",
        "uncertain": "oncall:uncertain"
      },
      "import_error": "oncall:import-error",
      "awaiting_approval": "oncall:awaiting-approval",
      "escalated": "oncall:escalated"
    },
    "priority": {
      "_comment": "Linear priority: 1=Urgent 2=High 3=Medium 4=Low (decision A7).",
      "import_error": 2,
      "non_retriable": 2,
      "uncertain": 3,
      "retriable": 4
    },
    "states": {
      "_comment": "Workflow state NAMES in the Linear team. Confirm before production (SRS Part 19).",
      "open": "Todo",
      "in_progress": "In Progress",
      "resolved": "Done"
    }
  },
  "ai": {
    "provider": "groq",
    "timeout_seconds": 60,
    "max_tokens": 4096,
    "max_log_chars": 20000,
    "max_source_chars": 20000,
    "max_patch_chars": 15000
  },
  "polling": {
    "interval_seconds": 60,
    "overlap_seconds": 300,
    "initial_lookback_minutes": 60
  },
  "analysis": {
    "worker_threads": 2
  },
  "policy": {
    "max_auto_retries": 2,
    "global_max_retries_per_hour": 10,
    "retry_verify_timeout_minutes": 30,
    "no_retry_dags": []
  },
  "approval": {
    "trusted_approvers": [],
    "comment_command": "/approve"
  },
  "mcp": {
    "allow_airflow_writes": false,
    "allow_linear_writes": false
  },
  "ownership": {
    "_comment": "Maps a GitHub login, commit email or Airflow DAG owner to a Linear user ID or email.",
    "user_map": {}
  },
  "storage": {
    "database_path": "./data/oncall.db"
  },
  "logging": {
    "level": "INFO",
    "format": "text",
    "dir": "./logs"
  }
}
