# /etc/oncall-agent/oncall-agent.env — NON-SECRET production settings (chmod 640, owner root:oncall).
# Secrets (AIRFLOW_TOKEN or AIRFLOW_PASSWORD, GITHUB_TOKEN, LINEAR_API_KEY, GROQ_API_KEY) are read
# from AWS SSM Parameter Store under ONCALL_SSM_PREFIX.
APP_ENV=production
ONCALL_INTEGRATION_MODE=real
ONCALL_SSM_PREFIX=/oncall-agent/prod/
AWS_REGION=eu-west-1
ONCALL_CONFIG_DIR=/opt/airflow-oncall-agent/config
ONCALL_ENV_FILE=/nonexistent

AIRFLOW_BASE_URL=https://airflow.example.com
# AIRFLOW_USERNAME=oncall-agent        # only with AIRFLOW_PASSWORD in SSM; otherwise AIRFLOW_TOKEN in SSM
GITHUB_REPOSITORY=example-org/airflow-dags
LINEAR_TEAM_ID=
LINEAR_PROJECT_ID=
LINEAR_DEFAULT_ASSIGNEE=
AI_PROVIDER=groq
GROQ_MODEL=openai/gpt-oss-120b

POLL_INTERVAL_SECONDS=60
ONCALL_MAX_AUTO_RETRIES=2
ONCALL_GLOBAL_MAX_RETRIES_PER_HOUR=10
ONCALL_RETRY_VERIFY_TIMEOUT_MINUTES=30
ONCALL_TRUSTED_APPROVERS=
ONCALL_MCP_ALLOW_AIRFLOW_WRITES=false
ONCALL_MCP_ALLOW_LINEAR_WRITES=false

ONCALL_DATABASE_PATH=/var/lib/oncall-agent/oncall.db
ONCALL_LOG_DIR=/var/log/oncall-agent
ONCALL_LOG_LEVEL=INFO
ONCALL_LOG_FORMAT=json
