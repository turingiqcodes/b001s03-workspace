# Airflow Oncall Agent — environment configuration.
# Copy to .env for local development:  cp .env.example .env
# Never commit .env. In production, secrets come from AWS SSM Parameter Store
# (see ONCALL_SSM_PREFIX below and docs/deployment.md).
#
# Precedence (highest first): real environment variables > .env > SSM (production
# secrets only) > config/<APP_ENV>.json > config/default.json.

# development | test | production
APP_ENV=development

# mock | real. Empty = config default: "mock" in development/test, "real" in production.
# Production refuses to start with "mock" or with any required credential missing.
# Empty values anywhere in this file are treated as "not set".
ONCALL_INTEGRATION_MODE=

# ---------------------------------------------------------------- Airflow 3.x
# Base URL of the Airflow API server, without /api/v2 (e.g. https://airflow.example.com).
AIRFLOW_BASE_URL=
# Authentication — set EXACTLY ONE method; setting both is a configuration error.
#   1. AIRFLOW_TOKEN: a JWT access token, sent as "Authorization: Bearer <token>".
#   2. AIRFLOW_USERNAME + AIRFLOW_PASSWORD: exchanged for a JWT at POST /auth/token
#      (Airflow 3 simple/FAB auth managers) and refreshed when it expires.
# HTTP Basic auth is NOT supported (Airflow 3 API v2 does not accept it by default).
AIRFLOW_USERNAME=
AIRFLOW_PASSWORD=
AIRFLOW_TOKEN=

# ---------------------------------------------------------------- GitHub
# Fine-grained token with read-only "Contents" access to the DAG repository.
GITHUB_TOKEN=
# owner/name, e.g. my-org/airflow-dags
GITHUB_REPOSITORY=

# ---------------------------------------------------------------- Linear
# Personal or workspace API key (sent as the Authorization header).
LINEAR_API_KEY=
LINEAR_TEAM_ID=
# Optional: project to file incidents under.
LINEAR_PROJECT_ID=
# Optional: Linear user ID or email used when no owner can be resolved.
LINEAR_DEFAULT_ASSIGNEE=

# ---------------------------------------------------------------- AI provider
# groq | mock. Empty = config default: "groq" (config/default.json), or "mock"
# in development (config/development.json). "mock" is rejected in production.
AI_PROVIDER=
# Groq API key (console.groq.com → API Keys). Sent as "Authorization: Bearer".
GROQ_API_KEY=
# Required when AI_PROVIDER=groq. No built-in default on purpose; pick a model that
# supports JSON mode, e.g. openai/gpt-oss-120b or llama-3.3-70b-versatile.
GROQ_MODEL=
# Optional. Groq's OpenAI-compatible endpoint (default shown).
GROQ_BASE_URL=https://api.groq.com/openai/v1

# ---------------------------------------------------------------- Monitoring
POLL_INTERVAL_SECONDS=60

# ---------------------------------------------------------------- Retry policy
# Maximum automatic retries per incident. 0 disables automatic retries entirely.
ONCALL_MAX_AUTO_RETRIES=2
# Maximum automatic retries across all incidents in a rolling hour. 0 disables them.
ONCALL_GLOBAL_MAX_RETRIES_PER_HOUR=10
# Escalate a retried task that is still running after this many minutes.
ONCALL_RETRY_VERIFY_TIMEOUT_MINUTES=30

# ---------------------------------------------------------------- Approvals
# Comma-separated Linear user IDs or emails allowed to approve restricted actions
# (rerun_dag, mark_success). EMPTY = every approval is rejected (except in mock mode).
ONCALL_TRUSTED_APPROVERS=

# ---------------------------------------------------------------- MCP servers
# Airflow write tools (clear an eligible failed task). Even when true, every call
# is re-checked by the policy engine and approval rules.
ONCALL_MCP_ALLOW_AIRFLOW_WRITES=false
# Linear write tools (create/update/comment/label/resolve).
ONCALL_MCP_ALLOW_LINEAR_WRITES=false

# ---------------------------------------------------------------- Storage and logging
ONCALL_DATABASE_PATH=./data/oncall.db
ONCALL_LOG_LEVEL=INFO
# text | json  (application log format on stderr; audit log is always JSON)
ONCALL_LOG_FORMAT=text
ONCALL_LOG_DIR=./logs

# ---------------------------------------------------------------- Production secrets
# Parameter Store path prefix, e.g. /oncall-agent/prod/ . When set, secret values
# (AIRFLOW_PASSWORD, AIRFLOW_TOKEN, GITHUB_TOKEN, LINEAR_API_KEY, GROQ_API_KEY)
# are read from <prefix><NAME> as SecureString parameters. Requires: pip install .[aws]
ONCALL_SSM_PREFIX=
