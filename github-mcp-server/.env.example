# Copy to .env and fill in. Never commit .env.

# --- Option 1: Personal Access Token (takes precedence if set) ---
GITHUB_TOKEN=

# --- Option 2: GitHub App ---
GITHUB_APP_ID=
GITHUB_APP_INSTALLATION_ID=
# Either inline (escaped newlines allowed) ...
GITHUB_APP_PRIVATE_KEY=
# ... or a file path
GITHUB_APP_PRIVATE_KEY_PATH=

# --- API ---
GITHUB_API_URL=https://api.github.com
GITHUB_TIMEOUT=30
GITHUB_MAX_RETRIES=3
GITHUB_MAX_RATE_LIMIT_WAIT=60
GITHUB_MAX_TEXT_CHARS=20000
GITHUB_DRY_RUN=false

# --- Transport ---
MCP_TRANSPORT=stdio
MCP_HOST=127.0.0.1
MCP_PORT=8000
# HTTP only: allow startup without server credentials; clients send X-GitHub-Token
GITHUB_PER_REQUEST_AUTH=false

LOG_LEVEL=INFO
